#!/usr/bin/env python3
"""glm-ask — 直接调用智谱 GLM-5-turbo（Anthropic 兼容入口），给一段 prompt，打印回答。

本仓库自带副本（C7b 无人值守:GitHub Actions runner 上没有全局 ~/.local/bin/glm-ask）。
与全局版逻辑一致，只加一条:key 优先读环境变量 ZHIPU_API_KEY（GitHub Secret 注入、不落盘），
读不到再回退 ~/.config/zhipu/api_key（本地开发照旧）。

用法:
  glm-ask "你的问题"
  echo "一大段内容" | glm-ask
  glm-ask --model glm-5.2 "问题"           # 指定模型，默认 glm-5-turbo(2026-08-15:5.2抽风返回空、5.3给condense长稿吐坏JSON连jsonrepair都修不了→切turbo,冷测两集浓缩JSON干净可过;standard-change)
  glm-ask --system "你是…" "问题"          # 加 system 提示
  glm-ask --max-tokens 8192 "问题"
"""
import sys, os, json, urllib.request, urllib.error

KEY_FILE = os.path.expanduser("~/.config/zhipu/api_key")
ENDPOINT = "https://open.bigmodel.cn/api/anthropic/v1/messages"


def read_key():
    # 优先环境变量(CI 走 GitHub Secret,不落盘);回退 key 文件(本地开发)。
    env = os.environ.get("ZHIPU_API_KEY", "").strip()
    if env:
        return env
    try:
        with open(KEY_FILE) as f:
            return f.read().strip()
    except FileNotFoundError:
        sys.exit(f"找不到智谱 key:环境变量 ZHIPU_API_KEY 未设 且 无 key 文件 {KEY_FILE}")


def main():
    args = sys.argv[1:]
    model = "glm-5-turbo"
    system = None
    max_tokens = 4096
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--model":
            model = args[i + 1]; i += 2
        elif a == "--system":
            system = args[i + 1]; i += 2
        elif a == "--max-tokens":
            max_tokens = int(args[i + 1]); i += 2
        else:
            rest.append(a); i += 1

    prompt = " ".join(rest).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        sys.exit('用法: glm-ask "你的问题"  或  echo 内容 | glm-ask')

    body = {
        "model": model,
        "max_tokens": max_tokens,
        # drift #92(2026-09-05 实锤):服务端把 glm-4.6/glm-5-turbo 路由到 glm-5.3-flash,它会**只回一个 thinking 块**
        # 把 max_tokens 烧光(stop_reason=max_tokens),永远轮不到 text → 本工具只取 text 块 → 输出为空。
        # 这是判官返回空(drift #82 的真凶,token 上限只是症状)/ 翻译整块「缺 50 条」/ 浓缩空返回的同一根因。
        # 实测:同一输入,不关思考 0/50;关掉后连打两次(含缓存命中)均 50/50。默认关;要开设 GLM_THINKING=on。
        **({} if os.environ.get("GLM_THINKING", "").lower() == "on" else {"thinking": {"type": "disabled"}}),
        "messages": [{"role": "user", "content": prompt}],
    }
    if system:
        body["system"] = system

    req = urllib.request.Request(
        ENDPOINT,
        data=json.dumps(body).encode("utf-8"),
        headers={
            "x-api-key": read_key(),
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        sys.exit(f"[HTTP {e.code}] {e.read().decode('utf-8', 'replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"网络错误: {e}")

    blocks = data.get("content", [])
    text = "".join(b.get("text", "") for b in blocks if b.get("type") == "text")
    if not text.strip():
        # 没有 text 块 = 上面那种病(或别的新病)。响亮说明,别让调用方把「空」当「模型没话说」(drift #92)
        sys.stderr.write(f"[glm-ask] ⚠️ 响应无有效 text 内容(块类型={[b.get('type') for b in blocks]} stop_reason={data.get('stop_reason')})—— 输出为空;调用方按「缺/重试」处理,退出码仍 0(drift #92)\n")
    print(text)
    u = data.get("usage", {})
    if u:
        sys.stderr.write(
            f"\n[{data.get('model','?')} | in {u.get('input_tokens','?')} / out {u.get('output_tokens','?')} tokens]\n"
        )


if __name__ == "__main__":
    main()
