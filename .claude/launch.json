{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quartz-site",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd site && eval \"$(fnm env)\" && fnm use 22.16.0 && node ./quartz/bootstrap-cli.mjs build --serve"
      ],
      "port": 8080
    },
    {
      "name": "ui-proto",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "exec python3 '设计稿/serve.py' ${PORT:-8123}"
      ],
      "port": 8123
    }
  ]
}
